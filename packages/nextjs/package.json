{
  "name": "@se-2/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:generate": "auth generate --config lib/auth.ts --output services/database/config/auth-schema.ts -y && prettier --write services/database/config/auth-schema.ts",
    "build": "yarn lint && next build",
    "check-types": "tsc --noEmit --incremental",
    "db:seed": "tsx services/database/seed.ts",
    "dev": "next dev",
    "drizzle-kit": "drizzle-kit",
    "format": "prettier --write . '!(node_modules|.next)/**/*'",
    "ipfs": "NEXT_PUBLIC_IPFS_BUILD=true yarn build && yarn bgipfs upload config init -u https://upload.bgipfs.com && CID=$(yarn bgipfs upload out | grep -o 'CID: [^ ]*' | cut -d' ' -f2) && [ ! -z \"$CID\" ] && echo '🚀 Upload complete! Your site is now available at: https://community.bgipfs.com/ipfs/'$CID || echo '❌ Upload failed'",
    "lint": "yarn eslint .",
    "serve": "next start",
    "start": "next dev",
    "vercel": "vercel --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env VERCEL_TELEMETRY_DISABLED=1",
    "vercel:login": "vercel login",
    "vercel:yolo": "vercel --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env NEXT_PUBLIC_IGNORE_BUILD_ERROR=true --build-env VERCEL_TELEMETRY_DISABLED=1",
    "gen:labs": "tsx scripts/gen-lab-sources.ts",
    "gen:oz": "tsx scripts/gen-oz-sources.ts",
    "validate-labs": "tsx scripts/validate-labs.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.192",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@heroicons/react": "~2.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@rainbow-me/rainbowkit": "2.2.9",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@scaffold-ui/components": "^0.1.10",
    "@scaffold-ui/debug-contracts": "^0.1.9",
    "@scaffold-ui/hooks": "^0.1.8",
    "@tanstack/react-query": "~5.59.15",
    "ai": "^6.0.190",
    "better-auth": "^1.7.2",
    "blo": "~2.0.0",
    "burner-connector": "0.0.20",
    "daisyui": "5.5.19",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "kubo-rpc-client": "~6.1.0",
    "next": "~16.2.4",
    "next-nprogress-bar": "~2.4.7",
    "next-plausible": "^4.0.0",
    "next-themes": "~0.4.6",
    "pg": "^8.23.0",
    "qrcode.react": "~4.2.0",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-hot-toast": "~2.6.0",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "solc": "^0.8.35",
    "tevm": "^1.0.0-next.149",
    "usehooks-ts": "~3.1.1",
    "viem": "2.39.0",
    "wagmi": "2.19.5",
    "zustand": "~5.0.12"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@tailwindcss/postcss": "4.2.4",
    "@trivago/prettier-plugin-sort-imports": "~6.0.2",
    "@types/node": "~18.19.130",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.14",
    "abitype": "1.0.6",
    "auth": "^1.7.2",
    "autoprefixer": "~10.4.20",
    "bgipfs": "~0.0.18",
    "drizzle-kit": "^0.31.10",
    "eslint": "~9.39.0",
    "eslint-config-next": "~16.2.4",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.5",
    "postcss": "~8.5.10",
    "prettier": "~3.8.3",
    "tailwindcss": "4.2.4",
    "tsx": "^4.22.4",
    "type-fest": "~5.6.0",
    "typescript": "~5.8.2",
    "vercel": "~52.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
